# Ollama is the default — no key needed. Override the daemon URL if it's not
# on the default port:
OLLAMA_HOST=http://localhost:11434

# Optional: enable additional chat-model providers in the Settings panel.
# Unset = that provider shows as unavailable in the UI; Ollama still works.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GitHub Models (an OpenAI-compatible endpoint) — a fine-grained PAT with
# "models: read" scope. https://github.com/marketplace/models
GITHUB_TOKEN=
